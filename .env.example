# Credenciales de tu app en Tiendanube Partners
TIENDANUBE_CLIENT_ID=tu_client_id
TIENDANUBE_CLIENT_SECRET=tu_client_secret

# URL de callback (debe coincidir con la configurada en Tiendanube Partners)
REDIRECT_URI=http://localhost:3000/auth/callback

# Secreto para sesiones Express (usá un string largo y aleatorio en producción)
SESSION_SECRET=un_secreto_aleatorio_seguro

# Puerto del servidor
PORT=3000

# Entorno
NODE_ENV=development

# Redis para sesiones persistentes (Railway lo provee automáticamente en producción)
# REDIS_URL=redis://...

# Modo demo (true para probar sin credenciales reales)
DEMO_MODE=true
